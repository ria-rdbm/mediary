# Copy this file to .env and fill in real values. Never commit .env.
# Expo only exposes variables prefixed EXPO_PUBLIC_ to client JS bundles —
# everything else here is for Supabase Edge Function secrets (set those with
# `supabase secrets set`, not in this file).

# --- Supabase (client) ---------------------------------------------------
# Project Settings → API → Project URL / anon public key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# --- Google Sign-In (client) ---------------------------------------------
# Google Cloud Console → APIs & Services → Credentials.
# webClientId is the "Web application" OAuth client (used for both
# platforms with @react-native-google-signin/google-signin).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
# iosClientId is the "iOS" OAuth client. iosUrlScheme is its reversed form,
# consumed by app.config.ts for the native redirect.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_GOOGLE_IOS_CLIENT_ID

# --- RevenueCat (client) ---------------------------------------------------
# RevenueCat dashboard → Project → API keys (the PUBLIC per-platform keys,
# safe for client bundles — never put a secret `sk_` key here).
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- EAS ---------------------------------------------------------------
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# ===========================================================================
# Everything below is set as a Supabase Edge Function secret, e.g.:
#   supabase secrets set REVENUECAT_WEBHOOK_AUTH_SECRET=... APPLE_TEAM_ID=...
# It is listed here only for documentation — do not read this file at
# runtime for these values.
# ===========================================================================

# supabase/functions/revenuecat-webhook
REVENUECAT_WEBHOOK_AUTH_SECRET=choose-a-long-random-string

# supabase/functions/sync-entitlement
REVENUECAT_PUBLIC_API_KEY_IOS=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXX
REVENUECAT_PUBLIC_API_KEY_ANDROID=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXX

# supabase/functions/apple-token-exchange and delete-account
# From Apple Developer → Certificates, IDs & Profiles → Keys (a "Sign in
# with Apple" key) and your registered Services ID / App ID.
APPLE_CLIENT_ID=nz.mediary.app
APPLE_TEAM_ID=YOUR_10_CHAR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_10_CHAR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Supabase Auth → Providers → Apple / Google, for the Supabase-hosted OAuth
# fallback (not used by the native signInWithIdToken flow, but required by
# `supabase/config.toml` for local `supabase start`).
APPLE_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
